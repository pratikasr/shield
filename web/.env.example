# ShieldVault, PositionRegistry, Repricer and Executor addresses; scripts/web-env.sh fills them from a deployment file
NEXT_PUBLIC_SHIELD_REGISTRY=
NEXT_PUBLIC_SHIELD_REPRICER=
NEXT_PUBLIC_SHIELD_EXECUTOR=
NEXT_PUBLIC_SHIELD_VAULT=
# HTTP RPC for Monad mainnet reads; empty uses https://rpc.monad.xyz; http://127.0.0.1:8545 for a local fork
NEXT_PUBLIC_MONAD_RPC_URL=
# Envio GraphQL endpoint for history (hosted endpoint on mainnet, http://localhost:8080/v1/graphql locally)
NEXT_PUBLIC_ENVIO_GRAPHQL_URL=
# WalletConnect Cloud project id; leave empty to offer injected wallets only
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Fork test builds only: an unlocked Anvil account for the Playwright test wallet. Leave empty everywhere else.
NEXT_PUBLIC_E2E_ACCOUNT=
