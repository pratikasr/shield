# Monad mainnet HTTP RPC used by forge fork tests, deploy scripts and the keeper, e.g. https://rpc.monad.xyz
MONAD_RPC_URL=
# Monad testnet HTTP RPC, e.g. https://testnet-rpc.monad.xyz
MONAD_TESTNET_RPC_URL=
# Deployer private key (0x-prefixed) for scripts/deploy-mainnet.sh. Never commit a real value.
DEPLOYER_PRIVATE_KEY=
# Keeper private key (0x-prefixed). Never commit a real value.
KEEPER_PRIVATE_KEY=
