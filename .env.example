# Monad mainnet HTTP RPC used by forge fork tests, deploy scripts and the keeper, e.g. https://rpc.monad.xyz
MONAD_RPC_URL=
# Monad testnet HTTP RPC, e.g. https://testnet-rpc.monad.xyz
MONAD_TESTNET_RPC_URL=
# Foundry keystore name for the deployer (preferred on mainnet; forge prompts for its password), e.g. shield-deployer
DEPLOYER_ACCOUNT=
# Deployer private key (0x-prefixed), for forks and CI only; set DEPLOYER_ACCOUNT instead on mainnet. Never commit a real value.
DEPLOYER_PRIVATE_KEY=
# Keeper address; required by scripts/deploy-mainnet.sh (it becomes the vault's unwinder)
KEEPER_ADDRESS=
# Path to a chmod 600 file outside the repo holding the keeper's key (preferred on mainnet), e.g. ~/.shield/keeper.key
KEEPER_PRIVATE_KEY_FILE=
# Keeper private key (0x-prefixed), for forks and CI only. Never commit a real value.
KEEPER_PRIVATE_KEY=
