# WebSocket RPC for monadNewHeads, e.g. wss://rpc.monad.xyz (mainnet) or ws://127.0.0.1:8545 (local fork)
MONAD_WS_URL=
# HTTP RPC for reads and eth_sendRawTransactionSync, e.g. https://rpc.monad.xyz
MONAD_RPC_URL=
# Chain id: 143 mainnet, 10143 testnet, 143 for a local mainnet fork
CHAIN_ID=
# Keeper private key (0x-prefixed). Never commit a real value.
KEEPER_PRIVATE_KEY=
