# WebSocket RPC for monadNewHeads, e.g. wss://rpc.monad.xyz; leave empty to poll over HTTP
MONAD_WS_URL=
# HTTP RPC for reads, gas estimates and eth_sendRawTransactionSync, e.g. https://rpc.monad.xyz
MONAD_RPC_URL=
# Chain id: 143 for Monad mainnet (and a local fork of it), 10143 for testnet
CHAIN_ID=
# Keeper private key (0x-prefixed); it pays gas and is the vault's unwinder. Never commit a real value.
KEEPER_PRIVATE_KEY=
# Path to contracts/deployments/<name>.json written by the deploy script (or set the three addresses below)
SHIELD_DEPLOYMENT_FILE=
# PositionRegistry address, if not taken from the deployment file
SHIELD_REGISTRY=
# Repricer address, if not taken from the deployment file
SHIELD_REPRICER=
# Executor address, if not taken from the deployment file
SHIELD_EXECUTOR=
# Pyth Hermes endpoint; Hermes needs an API key since 26 Aug 2026 (default https://hermes.pyth.network)
PYTH_HERMES_URL=
# Pyth Hermes API key; empty means the contracts read Pyth's on-chain push feeds (ADR-017)
PYTH_HERMES_API_KEY=
# Reprice every N proposed blocks (default 1; 0 turns repricing off)
REPRICE_EVERY_N_BLOCKS=
# Length of the every-N-blocks window in blocks before switching to the idle cadence (default 0 = no limit)
REPRICE_WINDOW_BLOCKS=
# Reprice cadence after the window (default 200 blocks)
REPRICE_IDLE_EVERY_N_BLOCKS=
# Gas buffer over the estimate in bps (default 1500); Monad charges the full limit
GAS_BUFFER_BPS=
# Fixed gas added to repriceMany limits for a new Pyth observation (default 25000)
REPRICE_GAS_HEADROOM=
# Log the decisions but send nothing: 1 or 0 (default 0)
DRY_RUN=
# debug, info, warn or error (default info)
LOG_LEVEL=
