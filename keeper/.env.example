# Empty values below mean "use the default". WebSocket RPC for monadNewHeads, e.g. wss://rpc.monad.xyz; empty polls over HTTP
MONAD_WS_URL=
# HTTP RPC for reads, gas estimates and eth_sendRawTransactionSync, e.g. https://rpc.monad.xyz (never logged; it may hold an API key)
MONAD_RPC_URL=
# Comma-separated extra read RPCs tried after MONAD_RPC_URL; default on chain 143 the public Monad RPCs, "off" for none (never used for sends)
RPC_FALLBACK_URLS=
# Chain id: 143 for Monad mainnet (and a local fork of it), 10143 for testnet
CHAIN_ID=
# Path to a chmod 600 file holding the keeper's 0x-prefixed private key (preferred over KEEPER_PRIVATE_KEY)
KEEPER_PRIVATE_KEY_FILE=
# Keeper private key (0x-prefixed), for forks and CI; set this or KEEPER_PRIVATE_KEY_FILE, not both. Never commit a real value.
KEEPER_PRIVATE_KEY=
# Single-instance lock file (default keeper/.keeper-<chain id>-<keeper address>.lock); a second keeper on the same account refuses to start
KEEPER_LOCK_FILE=
# Path to contracts/deployments/<name>.json written by the deploy script (or set the three addresses below)
SHIELD_DEPLOYMENT_FILE=
# PositionRegistry address, if not taken from the deployment file (must match it when both are set)
SHIELD_REGISTRY=
# Repricer address, if not taken from the deployment file (must match it when both are set)
SHIELD_REPRICER=
# Executor address, if not taken from the deployment file (must match it when both are set)
SHIELD_EXECUTOR=
# Pyth Hermes endpoint; Hermes needs an API key since 26 Aug 2026 (default https://hermes.pyth.network)
PYTH_HERMES_URL=
# Pyth Hermes API key; empty means the contracts read Pyth's on-chain push feeds (ADR-017)
PYTH_HERMES_API_KEY=
# Reprice every N proposed blocks inside the window (default 1; 0 turns repricing off)
REPRICE_EVERY_N_BLOCKS=
# Blocks of every-N repricing from the keeper's start before the idle cadence (default 600, about 3 minutes; 0 = no end)
REPRICE_WINDOW_BLOCKS=
# Reprice cadence after the window, counted from the last reprice (default 200 blocks)
REPRICE_IDLE_EVERY_N_BLOCKS=
# Below this keeper balance in wei, reprices stop and exits continue (default 200000000000000000 = 0.2 MON)
MIN_BALANCE_FOR_EXIT_WEI=
# Skip reprices while maxFeePerGas in wei is above this (default none; exits are never capped)
MAX_FEE_PER_GAS_REPRICE_WEI=
# Gas buffer over the estimate in bps (default 1500); Monad charges the full limit
GAS_BUFFER_BPS=
# Gas ceiling for one exit (default 3000000)
MAX_GAS_EXIT=
# Gas ceiling for one repriceMany; larger books are split into chunks under it (default 6000000)
MAX_GAS_REPRICE=
# Fixed gas added to repriceMany limits for a new Pyth observation (default 25000)
REPRICE_GAS_HEADROOM=
# HTTP polling interval in ms when no WebSocket heads arrive (default 150)
POLL_INTERVAL_MS=
# How long eth_sendRawTransactionSync waits for the receipt, in ms (default 2000)
SYNC_TIMEOUT_MS=
# Log the decisions but send nothing: 1 or 0 (default 0)
DRY_RUN=
# debug, info, warn or error (default info)
LOG_LEVEL=
