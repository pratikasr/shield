# Envio API token for HyperSync and hosted deployments; create one at https://envio.dev/app/api-tokens
ENVIO_API_TOKEN=
# Required. First block to index: the block of the Shield deployment (contracts/deployments/<name>.json "block")
ENVIO_START_BLOCK=
# Required. PositionRegistry address from contracts/deployments/<name>.json
ENVIO_REGISTRY_ADDRESS=
# Required. Repricer address
ENVIO_REPRICER_ADDRESS=
# Required. Executor address
ENVIO_EXECUTOR_ADDRESS=
# Required. ShieldVault address
ENVIO_VAULT_ADDRESS=
# Required. ShieldForwarderFactory address (deposit addresses, ADR-039)
ENVIO_FORWARDERS_ADDRESS=
# RPC URL; https://rpc.monad.xyz by default, http://127.0.0.1:8545 for a local fork
ENVIO_RPC_URL=
# "sync" to index from the RPC (local fork), "fallback" to use HyperSync first (default)
ENVIO_RPC_FOR=
# Local dev only: Hasura port when 8080 is taken (pair it with HASURA_GRAPHQL_ENDPOINT=http://localhost:<port>/v1/metadata)
HASURA_EXTERNAL_PORT=
HASURA_GRAPHQL_ENDPOINT=
