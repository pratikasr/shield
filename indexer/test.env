# Values for `envio codegen` (types only) and the unit tests, never for a running indexer. config.yaml has no
# defaults for these, so `envio dev` and `envio start` stop when indexer/.env (or the hosted env) lacks them.
# The addresses are not Shield contracts; they only give the test indexer something to attach events to.
ENVIO_START_BLOCK=0
ENVIO_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000001
ENVIO_REPRICER_ADDRESS=0x0000000000000000000000000000000000000002
ENVIO_EXECUTOR_ADDRESS=0x0000000000000000000000000000000000000003
ENVIO_VAULT_ADDRESS=0x0000000000000000000000000000000000000004
ENVIO_FORWARDERS_ADDRESS=0x0000000000000000000000000000000000000005
